{
  "name": "@hellharbor/hhe-commerce",
  "version": "0.2.1-rc1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hhe-commerce --local",
    "db:migrate:remote": "wrangler d1 migrations apply hhe-commerce --remote"
  },
  "devDependencies": { "typescript": "^5.8.3", "wrangler": "^4.36.0" }
}
